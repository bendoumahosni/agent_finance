# Copier en .env et remplir. Le .env n'est jamais commité.

# --- Clés d'API ---
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Postgres (utilisés par db ET par l'URL de l'API) ---
# Un seul endroit : la base et l'URL ne peuvent pas diverger.
POSTGRES_USER=hosni
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mabase

# --- Keycloak (développement) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=monrealm
OIDC_AUDIENCE=financial-agent

# --- Réglages optionnels (valeurs par défaut dans config.py) ---
# MODEL_NAME=gpt-6-astra
# USE_RESPONSES_API=false
# AGENT_TIMEOUT_SECONDS=60
# LOG_LEVEL=INFO

# --- Hors Docker uniquement ---
# Dans Docker, DATABASE_URL et les variables OIDC_* viennent du compose.
# DATABASE_URL=postgresql://hosni:change_me@localhost:5432/mabase
# OIDC_ISSUER=http://localhost:8080/realms/monrealm
# OIDC_JWKS_URL=http://localhost:8080/realms/monrealm/protocol/openid-connect/certs
