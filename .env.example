# Copier en .env et remplir. Le .env n'est JAMAIS commité.

# ============ OBLIGATOIRE ============
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Postgres : un seul endroit, la base et l'URL ne peuvent pas diverger
POSTGRES_USER=hosni
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mabase

# --- Identité (Keycloak / OIDC)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_REALM=monrealm
OIDC_AUDIENCE=financial-agent

# ============ PRODUCTION ============
# Nom public de l'API, utilisé par Caddy et par Keycloak.
# Sans domaine à vous : <IP-de-la-VM>.sslip.io
DOMAIN=localhost
# PUBLIC_BASE_URL sert à construire le lien de confirmation d'e-mail.
PUBLIC_BASE_URL=http://localhost:8000

# ============ SERVEURS MCP ============
MCP_SERVERS={"currency":"http://currency-mcp:8001/mcp"}
MCP_RETRY_SECONDS=30

# ============ E-MAIL (SMTP) ============
# SMTP_HOST vide = envoi désactivé, /emails répond 503.
# Développement avec Mailpit :
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=agent@exemple.fr
SMTP_USER=
SMTP_PASSWORD=
# Production (relais tiers : Brevo, Resend, Mailgun...) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=

# ============ LIMITATION DE DÉBIT ============
# 0 ou moins désactive la limitation.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ============ OBSERVABILITÉ (Langfuse) ============
# Sans clés, le traçage est désactivé : l'application fonctionne pareil.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Attention : LANGFUSE_HOST, surtout pas LANGFUSE_BASE_URL.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0

# ============ OPTIONNEL (valeurs par défaut dans config.py) ============
# LOG_LEVEL=INFO
# MODEL_NAME=gpt-6-astra
# USE_RESPONSES_API=false
# AGENT_TIMEOUT_SECONDS=60
# SEARCH_MAX_RESULTS=3
# POOL_MIN_SIZE=2
# POOL_MAX_SIZE=10

# --- Guardrails
# MAX_TOOL_CALLS_PER_RUN=10
# MAX_MODEL_CALLS_PER_RUN=8
# SUMMARIZE_AFTER_MESSAGES=40
# SUMMARIZE_KEEP_MESSAGES=20

# --- File de sortie et planificateur
# OUTBOX_POLL_SECONDS=10
# OUTBOX_MAX_ATTEMPTS=5
# SCHEDULER_POLL_SECONDS=30
# MAX_SCHEDULED_TASKS_PER_USER=5
# EMAIL_TOKEN_TTL_SECONDS=86400
# MAX_EMAIL_ADDRESSES_PER_USER=5

# ============ HORS DOCKER UNIQUEMENT ============
# Dans Docker, ces trois-là viennent du compose.
# DATABASE_URL=postgresql://hosni:change_me@localhost:5432/mabase
# OIDC_ISSUER=http://localhost:8080/realms/monrealm
# OIDC_JWKS_URL=http://localhost:8080/realms/monrealm/protocol/openid-connect/certs